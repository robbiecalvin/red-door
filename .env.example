# Backend
JWT_SECRET=change-me
PORT=3000
# Optional: PostgreSQL connection string for scalable auth/chat/profile/media persistence.
# If omitted, backend falls back to local JSON file storage.
DATABASE_URL=
# Optional alias for hosted Neon setups (used if DATABASE_URL is empty).
NEON_DATABASE_URL=
# Optional: set true when your Postgres provider requires TLS.
DATABASE_SSL=false
# Optional: fail fast at startup unless DATABASE_URL or NEON_DATABASE_URL is set.
REQUIRE_DATABASE=false

# Optional: comma-separated origin allowlist for browser/native webview requests
CORS_ALLOWED_ORIGINS=capacitor://localhost,http://localhost,http://127.0.0.1,ionic://localhost

# Optional: Google Apps Script web app URL used to append early-access signups to Google Sheets.
# Expected payload: { name, email, membershipCode, createdAtMs, source }
GOOGLE_SHEETS_WEBHOOK_URL=

# Frontend build-time runtime endpoints
# Default in this repo's dev/build scripts is __local__ (fully browser-local mode).
# Set /api (or a full backend origin) to use backend mode.
# Example: DUALMODE_API_BASE_PATH=https://api.example.com
DUALMODE_API_BASE_PATH=__local__

# Optional explicit websocket URL.
# Default in this repo's dev/build scripts is __disabled__ for static mode.
# Use /ws or wss://... when running backend realtime.
# Example: DUALMODE_WS_URL=wss://api.example.com/ws
DUALMODE_WS_URL=__disabled__

# Optional defaults used by map center
DUALMODE_DEFAULT_CENTER_LAT=40.7484
DUALMODE_DEFAULT_CENTER_LNG=-73.9857

# Optional dev-server controls (used by npm run dev / vite.dev.mjs)
DUALMODE_DEV_HMR=true
DUALMODE_DEV_WATCH=true
DUALMODE_DEV_WATCH_POLL=false
DUALMODE_DEV_WATCH_POLL_INTERVAL_MS=250

# Red Door Plus: create a recurring CAD 7.99 / month price in Stripe.
# Configure these securely on the backend host; never prefix secret keys with VITE_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
# Public frontend URL used by Checkout and the cancellation portal (HTTPS required).
PUBLIC_APP_URL=https://robbiecalvin.github.io/red-door/

# Server-side aggregate metrics and optional consent-based activity measurement.
# Individual activity still requires the user's explicit opt-in.
ANALYTICS_ENABLED=true

# Recovery and verification mail. With SMTP_SECURE=false, STARTTLS is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional custom domain, set only after DNS/Pages configuration is ready.
# Build-time public URL changes social metadata and generates dist/CNAME.
DUALMODE_PUBLIC_APP_URL=https://robbiecalvin.github.io/red-door/

# Meet Discreet bridge: backend-only shared secret, minimum 32 random characters.
# MD_API_BASE_URL is the MD backend API base, not necessarily its website.
MD_SHARED_SECRET=
MD_API_BASE_URL=https://meetdiscreet.ca/api
MD_SITE_URL=https://meetdiscreet.ca
# Optional additional HTTPS photo hostnames, comma-separated (no URL paths).
MD_MEDIA_ALLOWED_HOSTS=

# Operator declaration only: set true after mounting backend/.data on a persistent disk.
# Public boards use local files even when core records use PostgreSQL.
REDDOOR_LOCAL_DATA_PERSISTENT=false

# Optional launch-check CLI inputs; admin session token goes in secure settings only.
# REDDOOR_API_URL=https://red-door-api.onrender.com
# REDDOOR_ADMIN_SESSION_TOKEN=

# Standalone release: the MD bridge is not registered, even if legacy MD variables exist.
# Public HTTPS style, no credentials or query keys. Browser requests expose IP/view extent.
DUALMODE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
# Set staging to reject live Stripe keys on an isolated staging backend.
REDDOOR_ENV=development
